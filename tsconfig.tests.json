{
  "extends": "@devkit-inc/electron-ui/tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/*"] }
  },
  "include": ["tests/**/*", "electron/**/*", "src/**/*", "client/src/electron.d.ts"]
}
